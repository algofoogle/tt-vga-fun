only_toplevel=false 
value="
.param MprogW=1
.options savecurrents
.control

*  set temp=90
  save all
  tran 1n 12.8u
  write 05.raw v(dacout) v(dacmid1) v(dacmid2)

  set appendwrite
  alterparam MprogW=0.9
  reset
*  *set temp=10
  tran 1n 12.8u
  write 05.raw
* v(dacout)

.endc
"}
