C {devices/simulator_commands.sym} 130 -60 2 1 {name=COMMANDS2
simulator=ngspice
only_toplevel=false 
value="
.param MPW=6
.param MMW=4
.options savecurrents
.control

  save all
  *reset
  *alterparam MPW=6
  *alterparam MMW=4
  tran 1n 12.8u
  write 10.raw i(vvcc) i(vvss) vpos vneg vbias

  set appendwrite
  alterparam MPW=4
  alterparam MMW=4
  reset
  tran 1n 12.8u
  write 10.raw i(vvcc) i(vvss) vpos vneg vbias

.endc
"}
